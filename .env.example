# bKash — all five values are issued by bKash during merchant onboarding.
# Copy to .env and fill in. Never commit .env.

# "sandbox" or "live". Controls which base URL is used.
BKASH_ENV=sandbox

# Merchant API credentials.
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# Optional. Overrides the built-in base URL — set this only if bKash gave you a
# host that differs from the published sandbox/live endpoints.
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Where bKash redirects the customer back to after they approve or cancel.
# Must be a public https URL in live mode.
BKASH_CALLBACK_URL=https://example.com/api/payments/bkash/callback

# IPN / webhook. Pin the SNS topic bKash publishes your notifications on —
# it is shown in the TopicArn field of the first message you receive.
# Leaving it unset means any SNS topic with a valid AWS signature is accepted.
BKASH_WEBHOOK_TOPIC_ARN=
